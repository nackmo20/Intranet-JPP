{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eafc.local/schemas/eafc-drupal-report-v2.schema.json",
  "title": "EAFC Drupal Report v2",
  "type": "object",
  "required": ["schemaVersion", "reportId", "jobId", "generatedAt", "agentVersion", "items"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "reportId": { "type": "string" },
    "jobId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "agentVersion": { "type": "string" },
    "summary": { "type": "object", "properties": { "total": { "type": "integer" }, "success": { "type": "integer" }, "warning": { "type": "integer" }, "failed": { "type": "integer" }, "skipped": { "type": "integer" } }, "additionalProperties": false },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "structuredLog": { "type": "array", "items": { "$ref": "#/$defs/log" } },
    "inventoryUpdates": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "item": { "type": "object", "required": ["canonicalId", "status"], "properties": { "canonicalId": { "type": "string" }, "nodeId": { "type": "string" }, "drupalUrl": { "type": "string" }, "status": { "enum": ["success", "warning", "failed", "skipped", "conflict"] }, "before": { "type": "object" }, "after": { "type": "object" }, "operationsApplied": { "type": "array", "items": { "type": "object" } }, "verification": { "type": "object" }, "backup": { "type": "object" }, "errors": { "type": "array", "items": { "type": "object" } }, "warnings": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
    "log": { "type": "object", "required": ["at", "level", "event"], "properties": { "at": { "type": "string", "format": "date-time" }, "level": { "enum": ["debug", "info", "warning", "error"] }, "event": { "type": "string" }, "target": { "type": "string" }, "details": { "type": "object" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
